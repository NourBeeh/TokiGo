# WeTravellers Backend — Phase 9 AI provider configuration.
#
# These are variable NAMES only. Never commit real secrets — provide values
# via the deployment environment / shell / secrets manager.

# ---------------------------------------------------------------------------
# AI provider (OpenAI-compatible REST chat completions)
# ---------------------------------------------------------------------------

# REQUIRED at runtime for the real provider /ai/query.
# Without it the module still boots, but the endpoint returns 503.
AI_API_KEY=

# Optional. Defaults to: https://api.openai.com/v1
# Point it at any OpenAI-compatible endpoint (OpenRouter, Groq, DeepSeek, ...).
AI_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to: gpt-4o-mini
AI_MODEL=gpt-4o-mini

# NOTE: the optional secondary AI provider (AI_FALLBACK_PROVIDER, mock
# fallback policy) was REMOVED with the R-4 workstream — the module binds the
# single OpenAI-compatible provider unconditionally and its failures surface
# to the caller. Do not set AI_FALLBACK_PROVIDER; it is no longer read.

# ---------------------------------------------------------------------------
# PostgreSQL (Phase 11A local provisioning)
# ---------------------------------------------------------------------------

# All optional. When unset, src/config/database.config.ts falls back to the
# local development defaults shown after each name, which are exactly the
# values `docker-compose.yml` provisions — so `docker-compose up -d` followed
# by `npm start` works with no .env at all.
#
# Override these per environment; never commit a real password.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# Defaults: DB_HOST=localhost  DB_PORT=5432
#           DB_USER=wetravellers  DB_PASSWORD=wetravellers

#           DB_NAME=wetravellers

# ---------------------------------------------------------------------------
# Duffel flight booking provider (server-side only)
# ---------------------------------------------------------------------------
# Required for Duffel API integration. Never commit real access tokens.
DUFFEL_ACCESS_TOKEN=
# Optional alias supported by code for backward compatibility:
# DUFFEL_API_KEY=
# ---------------------------------------------------------------------------
# Database (Postgres). Leave empty to use the local dev defaults shared with
# docker-compose.yml (user/password/db = wetravellers, host localhost:5432).
# Never put real production credentials in this file.
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# ---------------------------------------------------------------------------
# Home marketplace dev seed
# No extra variables required: the seed reuses the DB_* settings above.
# Run manually from backend/: npm run seed:home  (safe to run repeatedly).
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Nuitee Connect hotel provider (server-side only, spec point 25)
# ---------------------------------------------------------------------------
# Free sandbox key: https://docs.liteapi.travel/docs/getting-a-sandbox-key
# sandbox (default) | live — live requires onboarding approval.
NUITEE_API_KEY=
NUITEE_MODE=sandbox

# ---------------------------------------------------------------------------
# Market defaults (spec point 3) — Egypt first.
# ---------------------------------------------------------------------------
DEFAULT_MARKET=EG

# ---------------------------------------------------------------------------
# Performance (2026-10-28)
# ---------------------------------------------------------------------------
# Server-side hotel-photo resizer. `GET /images/hotel?src=…&w=480`.
# Photos are cached as WebP files under IMAGE_CACHE_DIR (default
# backend/.cache/images) and evicted oldest-first above IMAGE_CACHE_MAX_BYTES.
IMAGE_CACHE_DIR=
IMAGE_CACHE_MAX_BYTES=268435456
# Comma-separated hostnames the proxy may fetch. Empty = built-in list
# (static.cupid.travel + the Unsplash/Duffel hosts the app already uses).
# Any other host is redirected to its original URL.
IMAGE_PROXY_HOSTS=

# Shared cache. When REDIS_URL (or REDIS_HOST) is set the backend uses Redis
# and silently falls back to the in-process map if Redis is unreachable.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# Live search results are presentation snapshots, revalidated before booking.
# 120s was too short to survive a Home → Search → Back round trip.
SEARCH_CACHE_TTL_SECONDS=300

# Home rail TTL (default 300s). Provider results are expensive to recompute.
RECOMMENDED_CACHE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# Search warmup (cold provider calls are 3.5-5s; warm is ~10ms)
# ---------------------------------------------------------------------------
# Warm the popular cities of the launch markets for the next weekend windows
# right after boot. Off by default so tests/laptops never call a paid provider.
WARM_SEARCH_ON_BOOT=false
# Re-run the warmer every N minutes (0 = once at boot). Each pass warms
# SEARCH_WARM_BATCH cities, rotating through the full list.
SEARCH_WARM_INTERVAL_MINUTES=0
SEARCH_WARM_BATCH=4
SEARCH_WARM_WEEKS=2
SEARCH_WARM_MARKETS=EG,AE,SA,TR,GB

# ---------------------------------------------------------------------------
# Image CDN (see docs/performance/cdn.md)
# ---------------------------------------------------------------------------
# The app is pointed at the edge with
#   --dart-define=IMAGE_BASE_URL=https://cdn.example.com
# Nothing is needed here: the origin already sends CDN-Cache-Control and
# Surrogate-Control. The edge must forward src/w/f and cache for a week.

# Warm the Home rail for the top markets right after boot (provider calls).
WARM_HOME_ON_BOOT=false

# ---------------------------------------------------------------------------
# Google Sign-In
# ---------------------------------------------------------------------------
# OAuth *web* client ID from Google Cloud Console (…apps.googleusercontent.com).
# It is the audience every accepted ID token must carry: the Android/iOS clients
# request their token against it, so the same value goes into the Flutter app.
# Comma-separate several IDs to accept more than one audience (e.g. while
# rotating). Empty = Google sign-in disabled: POST /auth/google answers 503.
GOOGLE_CLIENT_ID=
